FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@11.5.2 --activate

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/db packages/db
COPY services/auth/package.json services/auth/prisma.config.ts ./services/auth/
COPY services/auth/prisma ./services/auth/prisma
COPY services/stock/package.json services/stock/prisma.config.ts ./services/stock/
COPY services/stock/prisma ./services/stock/prisma
COPY services/order/package.json services/order/prisma.config.ts ./services/order/
COPY services/order/prisma ./services/order/prisma
COPY services/production/package.json services/production/prisma.config.ts ./services/production/
COPY services/production/prisma ./services/production/prisma
COPY services/shipment/package.json services/shipment/prisma.config.ts ./services/shipment/
COPY services/shipment/prisma ./services/shipment/prisma

RUN pnpm install --frozen-lockfile

CMD ["pnpm", "--filter", "@aeronexis/db", "run", "migrate:all"]
