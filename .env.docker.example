# Copier vers .env.docker pour pnpm docker:apps:up
# URLs reseau Docker (noms de services Compose)

POSTGRES_USER=aeronexis
POSTGRES_PASSWORD=aeronexis_dev

AUTH_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@postgres-auth:5432/aeronexis_auth
STOCK_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@postgres-stock:5432/aeronexis_stock
COMMANDE_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@postgres-commande:5432/aeronexis_commande
PRODUCTION_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@postgres-production:5432/aeronexis_production
EXPEDITION_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@postgres-expedition:5432/aeronexis_expedition

REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

LOG_LEVEL=info
