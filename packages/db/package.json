{
  "name": "@aeronexis/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "prepare": "tsc --noEmit",
    "build": "tsc --noEmit",
    "migrate:all": "node --import tsx scripts/migrate-all.ts deploy",
    "migrate:all:dev": "node --import tsx scripts/migrate-all.ts dev",
    "generate:all": "node --import tsx scripts/generate-all.ts",
    "seed:all": "node --import tsx scripts/seed-all.ts",
    "verify-seed": "node --import tsx scripts/verify-seed.ts",
    "lint": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "node -e \"process.exit(0)\"",
    "dev": "node -e \"console.log('@aeronexis/db: tooling package')\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.2",
    "ioredis": "^5.11.0",
    "mongodb": "^6.17.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
