{
  "name": "aeronexis-erp",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:gateway": "pnpm --filter @aeronexis/gateway dev",
    "dev:auth": "pnpm --filter @aeronexis/auth dev",
    "dev:stock": "pnpm --filter @aeronexis/stock dev",
    "dev:order": "pnpm --filter @aeronexis/order dev",
    "dev:production": "pnpm --filter @aeronexis/production dev",
    "dev:shipment": "pnpm --filter @aeronexis/shipment dev",
    "dev:reporting": "pnpm --filter @aeronexis/reporting dev",
    "dev:audit": "pnpm --filter @aeronexis/audit dev",
    "dev:notification": "pnpm --filter @aeronexis/notification dev",
    "dev:backend": "node --import tsx scripts/dev-backend.ts",
    "backend": "pnpm dev:backend",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json",
    "dev:backend:parallel": "pnpm --parallel --filter @aeronexis/auth --filter @aeronexis/stock --filter @aeronexis/order --filter @aeronexis/production --filter @aeronexis/shipment --filter @aeronexis/reporting --filter @aeronexis/audit --filter @aeronexis/notification --filter @aeronexis/gateway dev",
    "dev:web": "pnpm --filter web dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:apps:up": "docker compose -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.apps.yml up -d --build",
    "docker:apps:down": "docker compose -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.apps.yml down",
    "smoke:kafka": "node --import tsx scripts/smoke-kafka-bus.ts",
    "smoke:cross-service": "node --import tsx scripts/smoke-cross-service.ts",
    "mongo:init": "pnpm --filter @aeronexis/mongo-init run init",
    "db:migrate": "pnpm --filter @aeronexis/db run migrate:all",
    "db:migrate:dev": "pnpm --filter @aeronexis/db run migrate:all:dev",
    "db:seed": "pnpm --filter @aeronexis/db run seed:all",
    "db:reset": "pnpm db:migrate && pnpm db:seed",
    "db:verify-seed": "pnpm --filter @aeronexis/db run verify-seed",
    "db:studio:auth": "pnpm --filter @aeronexis/auth run db:studio",
    "db:studio:stock": "pnpm --filter @aeronexis/stock run db:studio",
    "db:studio:order": "pnpm --filter @aeronexis/order run db:studio",
    "db:studio:production": "pnpm --filter @aeronexis/production run db:studio",
    "db:studio:shipment": "pnpm --filter @aeronexis/shipment run db:studio",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv": "^17.4.2",
    "kafkajs": "^2.2.4",
    "moleculer": "^0.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
