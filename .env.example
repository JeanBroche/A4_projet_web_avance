# PostgreSQL (5 conteneurs Docker — ports hote distincts pour dev hybride)
POSTGRES_USER=aeronexis
POSTGRES_PASSWORD=aeronexis_dev

AUTH_PG_PORT=5432
STOCK_PG_PORT=5433
ORDER_PG_PORT=5434
PRODUCTION_PG_PORT=5435
SHIPMENT_PG_PORT=5436

# Bases PostgreSQL dediees par microservice Prisma (1 conteneur PG par MS)
AUTH_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@localhost:5432/aeronexis_auth
STOCK_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@localhost:5433/aeronexis_stock
ORDER_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@localhost:5434/aeronexis_order
PRODUCTION_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@localhost:5435/aeronexis_production
SHIPMENT_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@localhost:5436/aeronexis_shipment

# MongoDB (logs / audit)
MONGO_PORT=27017
MONGO_URI=mongodb://localhost:27017/aeronexis

# Redis (cache KPI, sessions auth, verrous distribues)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API Gateway (Moleculer moleculer-web, issue #5)
GATEWAY_PORT=4000
GATEWAY_URL=http://localhost:4000

# API response envelope ({ status: success|failure, data|error })
API_SUCCESS_ENVELOPE=true

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Auth cookies (gateway)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Seed dev (services/auth)
SEED_ADMIN_PASSWORD=change-me-dev-only

# Kafka (KRaft — transporter Moleculer RPC + evenements metier kafkajs)
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=moleculer-aeronexis
# Docker apps : KAFKA_BROKERS=kafka:9092
# Override transporter (minuscules kafka:// obligatoire) :
# MOLECULER_TRANSPORTER=kafka://localhost:9092

# Ollama (assistant IA création OF — apps/web)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# MinIO (S3-compatible)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
# Docker apps : MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aeronexis-docs
