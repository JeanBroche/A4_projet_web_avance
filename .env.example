# PostgreSQL (Docker Compose)
POSTGRES_USER=aeronexis
POSTGRES_PASSWORD=aeronexis_dev
POSTGRES_DB=aeronexis
POSTGRES_PORT=5432
# Connexion admin (psql -l, pg_dump, etc.). N'est plus utilisee par les services Prisma.
POSTGRES_URL=postgresql://aeronexis:aeronexis_dev@localhost:5432/aeronexis

# Bases PostgreSQL dediees par microservice Prisma (initialisees par infra/postgres/init.sql)
AUTH_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@localhost:5432/aeronexis_auth
STOCK_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@localhost:5432/aeronexis_stock
COMMANDE_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@localhost:5432/aeronexis_commande
PRODUCTION_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@localhost:5432/aeronexis_production
EXPEDITION_DATABASE_URL=postgresql://aeronexis:aeronexis_dev@localhost:5432/aeronexis_expedition

# MongoDB (logs / audit)
MONGO_PORT=27017
MONGO_URI=mongodb://localhost:27017/aeronexis

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API Gateway (Moleculer moleculer-web, issue #5)
GATEWAY_PORT=4000
GATEWAY_URL=http://localhost:4000

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seed dev (services/auth)
SEED_ADMIN_PASSWORD=change-me-dev-only

# Seed dev (services/auth)
SEED_ADMIN_PASSWORD=change-me-dev-only

# Kafka (KRaft, single broker)
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092

# MinIO (S3-compatible)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aeronexis-docs
