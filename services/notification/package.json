{
  "name": "@aeronexis/notification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx ./node_modules/moleculer/bin/moleculer-runner.js --config moleculer.config.ts --hot services/**/*.service.ts",
    "start": "node --import tsx ./node_modules/moleculer/bin/moleculer-runner.js --config moleculer.config.ts services/**/*.service.ts",
    "call:ping": "node --import tsx ./node_modules/moleculer-cli/bin/moleculer.js call notification.ping -c moleculer.config.ts --id moleculer-cli --level error",
    "db:seed": "node --import tsx scripts/seed-notification.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@aeronexis/moleculer-config": "workspace:*",
    "@aeronexis/shared": "workspace:*",
    "@aeronexis/redis-infra": "workspace:*",
    "@aeronexis/services-shared": "workspace:*",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "moleculer": "^0.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "moleculer-cli": "^0.8.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
