generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["commande"]
}

model Client {
  id                String          @id @default(cuid())
  code              String
  name              String
  country           String?
  type              String?
  annualRevenue     Int?
  firstContractDate DateTime?       @db.Date
  status            String          @default("active")
  siteCode          String
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  orders            CustomerOrder[]

  @@index([siteCode])
  @@index([deletedAt])
  @@index([code])
  @@schema("commande")
  @@map("clients")
}

model CustomerOrder {
  id                   String               @id @default(cuid())
  orderNumber          String
  clientId             String
  siteCode             String
  status               String               @default("DRAFT")
  isUrgent             Boolean              @default(false)
  dueDate              DateTime?
  promisedDeliveryDate DateTime?
  totalAmount          Int                  @default(0)
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  client               Client               @relation(fields: [clientId], references: [id])
  lines                CustomerOrderLine[]
  statusHistory        OrderStatusHistory[]
  validations          OrderValidation[]

  @@index([clientId])
  @@index([siteCode])
  @@index([status])
  @@index([isUrgent])
  @@index([deletedAt])
  @@index([orderNumber])
  @@schema("commande")
  @@map("customer_orders")
}

model CustomerOrderLine {
  id          String        @id @default(cuid())
  orderId     String
  lineNumber  Int
  productCode String
  description String?
  quantity    Int
  unitPrice   Int?
  ofId        String?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productCode])
  @@index([deletedAt])
  @@schema("commande")
  @@map("customer_order_lines")
}

model OrderStatusHistory {
  id         String        @id @default(cuid())
  orderId    String
  fromStatus String?
  toStatus   String
  changedBy  String
  notes      String?
  createdAt  DateTime      @default(now())
  order      CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@schema("commande")
  @@map("order_status_history")
}

model OrderValidation {
  id          String        @id @default(cuid())
  orderId     String
  action      String
  reason      String?
  validatedBy String
  createdAt   DateTime      @default(now())
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@schema("commande")
  @@map("order_validations")
}
