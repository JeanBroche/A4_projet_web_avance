generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["stock"]
}

model Material {
  id                String    @id @default(cuid())
  code              String
  description       String?
  unit              String
  currentStock      Int       @default(0)
  minimumStock      Int       @default(0)
  reservedStock     Int       @default(0)
  supplier          String?
  lastReplenishment DateTime? @db.Date
  siteCode          String
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([siteCode])
  @@index([deletedAt])
  @@index([siteCode, code])
  @@schema("stock")
  @@map("materials")
}
