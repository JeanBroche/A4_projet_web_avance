generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["stock"]
}

model Material {
  id                String    @id @default(cuid())
  code              String
  description       String?
  unit              String
  currentStock      Int       @default(0)
  minimumStock      Int       @default(0)
  reservedStock     Int       @default(0)
  supplier          String?
  lastReplenishment DateTime? @db.Date
  siteCode          String
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  movements      StockMovement[]
  reservations   StockReservation[]
  alerts         StockAlert[]
  delays         SupplierDelay[]
  lots           MaterialLot[]
  purchaseOrders PurchaseOrder[]

  @@index([siteCode])
  @@index([deletedAt])
  @@index([siteCode, code])
  @@schema("stock")
  @@map("materials")
}

model StockMovement {
  id          String   @id @default(cuid())
  materialId  String
  siteCode    String
  type        String
  quantity    Int
  reason      String?
  documentRef String?
  createdAt   DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@index([siteCode])
  @@index([type])
  @@index([createdAt])
  @@schema("stock")
  @@map("stock_movements")
}

model StockReservation {
  id         String    @id @default(cuid())
  ofId       String
  materialId String
  siteCode   String
  quantity   Int
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  releasedAt DateTime?

  material Material @relation(fields: [materialId], references: [id])

  @@index([ofId])
  @@index([materialId])
  @@index([siteCode])
  @@index([status])
  @@schema("stock")
  @@map("stock_reservations")
}

model StockAlert {
  id         String    @id @default(cuid())
  materialId String
  siteCode   String
  severity   String    @default("WARNING")
  message    String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  material Material @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@index([siteCode])
  @@index([resolvedAt])
  @@schema("stock")
  @@map("stock_alerts")
}

model SupplierDelay {
  id           String    @id @default(cuid())
  materialId   String
  supplier     String
  expectedDate DateTime  @db.Date
  actualDate   DateTime? @db.Date
  notes        String?
  createdAt    DateTime  @default(now())

  material Material @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@index([supplier])
  @@index([expectedDate])
  @@schema("stock")
  @@map("supplier_delays")
}

model PurchaseOrder {
  id              String    @id @default(cuid())
  poNumber        String    @unique
  materialId      String
  siteCode        String
  supplier        String
  quantity        Int
  receivedQty     Int       @default(0)
  unitPrice       Float?
  status          String    @default("DRAFT")
  expectedDate    DateTime? @db.Date
  receivedDate    DateTime? @db.Date
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  material Material @relation(fields: [materialId], references: [id])

  @@index([materialId])
  @@index([siteCode])
  @@index([status])
  @@index([supplier])
  @@schema("stock")
  @@map("purchase_orders")
}

model MaterialLot {
  id              String    @id @default(cuid())
  materialId      String
  siteCode        String
  lotNumber       String
  supplierLot     String?
  supplier        String?
  certificateRef  String?
  certificateUrl  String?
  manufacturedAt  DateTime? @db.Date
  expiryAt        DateTime? @db.Date
  receivedAt      DateTime  @default(now()) @db.Date
  quantity        Int
  remainingQty    Int
  location        String?
  status          String    @default("ACTIVE")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  material Material @relation(fields: [materialId], references: [id])

  @@unique([materialId, lotNumber])
  @@index([siteCode])
  @@index([status])
  @@index([expiryAt])
  @@schema("stock")
  @@map("material_lots")
}
