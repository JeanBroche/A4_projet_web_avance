{
  "name": "@aeronexis/stock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/db.js",
  "types": "./dist/db.d.ts",
  "exports": {
    ".": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js"
    }
  },
  "scripts": {
    "dev": "node -e \"console.log('@aeronexis/stock: dev placeholder')\"",
    "db:generate": "prisma generate",
    "build": "prisma generate && tsc",
