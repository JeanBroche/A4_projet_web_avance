generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["production"]
}

model ProductStock {
  id               String    @id @default(cuid())
  productCode      String
  description      String?
  quantity         Int       @default(0)
  reservedQuantity Int       @default(0)
  siteCode         String
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([siteCode])
  @@index([deletedAt])
  @@index([siteCode, productCode])
  @@schema("production")
  @@map("product_stocks")
}
