generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["production"]
}

model ProductStock {
  id               String    @id @default(cuid())
  productCode      String
  description      String?
  quantity         Int       @default(0)
  reservedQuantity Int       @default(0)
  siteCode         String
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([siteCode])
  @@index([deletedAt])
  @@index([siteCode, productCode])
  @@schema("production")
  @@map("product_stocks")
}

model BOMProduct {
  id               String    @id @default(cuid())
  bom_code         String
  material_id      String
  description      String?
  quantity         Int       @default(1)
  status           String    @default("PENDING")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([bom_code])
  @@schema("production")
}

model BatchProduct {
  id               String    @id @default(cuid())
  batch_code       String
  bom_id           String
  command_id       String
  status           String    @default("PENDING")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([batch_code])
  @@schema("production")
}

