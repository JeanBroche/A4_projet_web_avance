generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["production"]
}

model ProductStock {
  id               String    @id @default(cuid())
  productCode      String
  description      String?
  quantity         Int       @default(0)
  reservedQuantity Int       @default(0)
  siteCode         String
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([siteCode])
  @@index([deletedAt])
  @@index([siteCode, productCode])
  @@schema("production")
  @@map("product_stocks")
}

model BOMProduct {
  id               String    @id @default(cuid())
  bom_code         String
  material_id      String
  description      String?
  quantity         Int       @default(1)
  status           String    @default("PENDING")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([bom_code])
  @@schema("production")
}

model BatchProduct {
  batch_id               String    @id @default(cuid())
  batch_code       String
  bom_id           String
  command_id       String
  status           String    @default("PENDING")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  anomalies        Anomalies_Batch[]
  @@schema("production")
}

model Anomalies_Batch {
  anomaly_id       String    
  batch_id         String

  batch            BatchProduct @relation(fields: [batch_id], references: [batch_id])
  anomaly          Anomalies @relation(fields: [anomaly_id], references: [anomaly_id])

  @@id([batch_id, anomaly_id])

  @@index([batch_id])
  @@index([anomaly_id])
  @@schema("production")
}

model Anomalies {
  anomaly_id       String    @id @default(cuid())
  batch_id         String
  anomaly_code     String
  description      String
  status           String    @default("OPEN")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  batches          Anomalies_Batch[]

  @@schema("production")
}
