{
  "name": "@aeronexis/order",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": "./src/db.ts"
  },
  "scripts": {
    "dev": "node --import tsx ./node_modules/moleculer/bin/moleculer-runner.js --config moleculer.config.ts --hot services/**/*.service.ts",
    "start": "node --import tsx ./node_modules/moleculer/bin/moleculer-runner.js --config moleculer.config.ts services/**/*.service.ts",
    "call:ping": "node --import tsx ./node_modules/moleculer-cli/bin/moleculer.js call order.ping -c moleculer.config.ts --id moleculer-cli --level error",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio --browser none --port 5557",
    "build": "prisma generate && tsc --noEmit",
    "lint": "prisma generate && tsc --noEmit",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@aeronexis/db": "workspace:*",
    "@aeronexis/moleculer-config": "workspace:*",
    "@aeronexis/redis-infra": "workspace:*",
    "@aeronexis/services-shared": "workspace:*",
    "@aeronexis/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "moleculer": "^0.15.0",
    "pg": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.2",
    "moleculer-cli": "^0.8.2",
    "prisma": "^7.8.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
