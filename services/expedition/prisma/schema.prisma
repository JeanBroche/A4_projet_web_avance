generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["expedition"]
}

model Delivery {
  id                   String    @id @default(cuid())
  code                 String
  orderNumber          String
  status               String    @default("pending")
  expectedDeliveryDate DateTime? @db.Date
  shippedAt            DateTime?
  siteCode             String
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([siteCode])
  @@index([orderNumber])
  @@index([deletedAt])
  @@index([code])
  @@schema("expedition")
  @@map("deliveries")
}
